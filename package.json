{
  "name": "sironic-erp-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:unit": "turbo run test",
    "test:integration": "turbo run test:integration",
    "preflight": "pnpm lint && pnpm typecheck && pnpm test && node scripts/verify-button-aschild.mjs && node scripts/verify-portal-isolation.mjs && pnpm build",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "migrate": "tsx scripts/migrate/run.ts",
    "test:migrate": "vitest run scripts/migrate"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@erp/admin": "workspace:*",
    "@erp/arlista": "workspace:*",
    "@erp/auth": "workspace:*",
    "@erp/bizonylat": "workspace:*",
    "@erp/core": "workspace:*",
    "@erp/db-core": "workspace:*",
    "@erp/infra": "workspace:*",
    "@erp/ertekesites": "workspace:*",
    "@erp/eszkoz": "workspace:*",
    "@erp/keszlet": "workspace:*",
    "@erp/lib": "workspace:*",
    "@erp/media": "workspace:*",
    "@erp/partner": "workspace:*",
    "@erp/projekt": "workspace:*",
    "@erp/rbac": "workspace:*",
    "@erp/secrets": "workspace:*",
    "@erp/szerviz": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "mongodb-memory-server": "^11.2.0",
    "mongoose": "^9.2.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^4.0.18"
  }
}
