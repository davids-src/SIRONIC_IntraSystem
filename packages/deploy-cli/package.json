{
  "name": "@sironic/deploy-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "sironic-deploy": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "echo \"No lint configured for @sironic/deploy-cli\"",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.mjs --passWithNoTests"
  },
  "dependencies": {
    "@crm/types": "workspace:*",
    "commander": "^13.1.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
